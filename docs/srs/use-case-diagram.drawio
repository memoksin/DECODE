        <!-- Includes (dashed, open arrow, base -> included) -->
        <mxCell id="i1" value="«include»" style="endArrow=open;dashed=1;html=1;endSize=10;" edge="1" parent="1" source="uc01" target="uc06">
          <mxGeometry relative="1" as="geometry" />
