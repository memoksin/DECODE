<mxfile host="app.diagrams.net">
  <diagram id="usecase" name="Use Case Diagram">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- System boundary -->
        <mxCell id="sys" value="DECODE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="170" y="10" width="580" height="540" as="geometry" />
        </mxCell>

        <!-- Actors -->
        <mxCell id="interviewer" value="Interviewer" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="researcher" value="Researcher" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="candidate" value="Candidate" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="210" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="platform" value="«system»&lt;br&gt;Videoconferencing&lt;br&gt;Platform" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="400" width="30" height="60" as="geometry" />
        </mxCell>

        <!-- Use cases: left column -->
        <mxCell id="uc01" value="Run Analysis Session" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="60" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc07" value="View Classification Report" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="140" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc08" value="Import Eye-tracking Dataset" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="300" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc09" value="Generate Trending Paths" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="380" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc10" value="Evaluate Classification Model" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="460" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Use cases: right column -->
        <mxCell id="uc06" value="Classify Experience Level" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="40" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc05" value="Map Gaze to Code Lines" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="120" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc02" value="Give Consent" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="200" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc03" value="Calibrate Gaze" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="280" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="uc04" value="Capture Video Streams" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="400" width="210" height="50" as="geometry" />
        </mxCell>

        <!-- Associations (plain lines) -->
        <mxCell id="a1" style="endArrow=none;html=1;" edge="1" parent="1" source="interviewer" target="uc01">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" style="endArrow=none;html=1;" edge="1" parent="1" source="interviewer" target="uc07">
          <mxGeometry relative="1" as="geometry" />
