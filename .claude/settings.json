{
  "enabledPlugins": {
    "linear@anthropic-plugin-directory": true
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/time-reminder.md"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/inbox.py || python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/inbox.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*[Ll]inear.*__save_issue$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/linear-time-rules.py || python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/linear-time-rules.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/inbox.py --session || python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/inbox.py --session",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/setup_check.py || python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/setup_check.py",
            "timeout": 40
          }
        ]
      }
    ]
  }
}
