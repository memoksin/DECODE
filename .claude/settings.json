{
  "enabledPlugins": {
    "linear@anthropic-plugin-directory": true
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/time-reminder.md"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*linear.*__save_issue",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/linear-time-rules.sh"
          }
        ]
      }
    ]
  }
}
